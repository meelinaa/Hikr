<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Hikr.Maui.App.ViewModels"
             x:Class="Hikr.Maui.App.Views.HomePage"
             Title="HomePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="#1b4d3e" StrokeThickness="0">
            <Label Text="{Binding HeaderText}"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"
                   Padding="20,15,20,20" />
        </Border>

        <!-- Subtitle -->
        <Label Grid.Row="1"
               Text="{Binding SubtitleText}"
               TextColor="Gray"
               FontSize="16"
               Padding="20,15,20,10" />

        <!-- List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Routes}"
                        Margin="20,10,20,90">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:RouteMock">
                    <Border Margin="0,0,0,15"
                            Padding="15"
                            Stroke="LightGray"
                            StrokeThickness="1"
                            BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                                   
                            <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5" HorizontalOptions="End">
                                <Label Text="{Binding TransportIcon}" FontSize="16" VerticalOptions="Center" />
                                <Label Text="{Binding TransportType}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                            </StackLayout>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="15" Margin="0,15,0,0">
                                <Label Text="{Binding Distance, StringFormat='Entfernung: {0}'}" FontSize="14" TextColor="DarkGray" />
                                <Label Text="{Binding Duration, StringFormat='Dauer: {0}'}" FontSize="14" TextColor="DarkGray" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Floating Action Button (+) -->
        <Button Grid.Row="0" Grid.RowSpan="3"
                Text="+"
                FontSize="36"
                TextColor="White"
                BackgroundColor="#1b4d3e"
                CornerRadius="30"
                WidthRequest="60"
                HeightRequest="60"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="0,0,0,5"
                Shadow="{Shadow Brush=Black, Offset='0,5', Opacity=0.3, Radius=5}"
                Command="{Binding CreateRouteCommand}" />

    </Grid>

</ContentPage>