<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hikr.Views.ProfilePage"
             BackgroundColor="Transparent">

    <Grid VerticalOptions="Fill" HorizontalOptions="Fill" BackgroundColor="#F2F4F7">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
            <Label Text="👤" FontSize="64" HorizontalOptions="Center" />
            <Label Text="Profil" FontSize="24" FontAttributes="Bold"
                   TextColor="#1A1A2E" HorizontalOptions="Center" />
            <Label Text="Dein Konto &amp; Einstellungen" FontSize="14"
                   TextColor="#66000000" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentView>
