<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Hikr.MainPage">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior 
            StatusBarColor="Transparent" 
            StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>

    <Grid>
        <mapsui:MapControl 
            x:Name="mapView" 
            VerticalOptions="Fill" 
            HorizontalOptions="Fill" />

        <!-- 1. OBERE KLASSISCHE SUCHLEISTE (Standardmodus) -->
        <Border x:Name="singleSearchPanel"
                VerticalOptions="Start" 
                HorizontalOptions="Fill" 
                Margin="15,40,15,10" 
                BackgroundColor="White"
                StrokeThickness="0"
                IsVisible="{Binding IsSingleSearchPanelVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <VerticalStackLayout>
                <SearchBar x:Name="searchBar" 
                           Placeholder="Ort, PLZ oder Straße suchen..." 
                           SearchButtonPressed="OnSearchButtonPressed"
                           Text="{Binding SearchBarText, Mode=TwoWay}" />

                <CollectionView x:Name="suggestionsList"
                                IsVisible="{Binding IsSuggestionsListVisible}"
                                ItemsSource="{Binding Suggestions}"
                                MaximumHeightRequest="250"
                                Margin="10,0,10,10"
                                SelectionMode="Single"
                                SelectionChanged="OnSuggestionSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10">
                                <Label Text="{Binding DisplayName}" 
                                       TextColor="Black" 
                                       FontSize="14"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- 2. OBERES ERWEITERTES ROUTING-PANEL (Directions-Modus) -->
        <Border x:Name="routingPanel"
                VerticalOptions="Start"
                HorizontalOptions="Fill"
                Margin="15,40,15,10"
                BackgroundColor="White"
                StrokeThickness="0"
                IsVisible="{Binding IsRoutingPanelVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout Padding="10" Spacing="10">
                <!-- Back-Button und die zwei Eingabefelder -->
                <Grid ColumnDefinitions="40, *, 40" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="8">
                    <!-- Zurück-Button -->
                    <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                            Text="←" 
                            FontAttributes="Bold"
                            FontSize="18"
                            TextColor="Black"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Command="{Binding ExitRoutingCommand}" />

                    <!-- Startpunkt -->
                    <Entry Grid.Row="0" Grid.Column="1"
                           x:Name="startEntry"
                           Placeholder="Startpunkt wählen..."
                           Text="{Binding StartEntryText, Mode=TwoWay}"
                           TextColor="Black"
                           FontSize="14"
                           BackgroundColor="#F0F2F5"
                           HeightRequest="36"
                           Focused="OnStartEntryFocused" />

                    <!-- Zielpunkt -->
                    <Entry Grid.Row="1" Grid.Column="1"
                           x:Name="destinationEntry"
                           Placeholder="Zielort..."
                           Text="{Binding DestinationEntryText, Mode=TwoWay}"
                           TextColor="Black"
                           FontSize="14"
                           BackgroundColor="#F0F2F5"
                           HeightRequest="36"
                           Focused="OnDestinationEntryFocused" />

                    <!-- Tausch-Button -->
                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                            Text="⇅" 
                            FontSize="20"
                            TextColor="Black"
                            BackgroundColor="Transparent"
                            Command="{Binding SwapLocationsCommand}" />
                </Grid>

                <!-- Routenvorschlagsliste für Start und Ziel -->
                <CollectionView x:Name="routingSuggestionsList"
                                IsVisible="{Binding IsRoutingSuggestionsListVisible}"
                                ItemsSource="{Binding RoutingSuggestions}"
                                MaximumHeightRequest="200"
                                Margin="10,0,10,0"
                                SelectionMode="Single"
                                SelectionChanged="OnRoutingSuggestionSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10">
                                <Label Text="{Binding DisplayName}" 
                                       TextColor="Black" 
                                       FontSize="14"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Transportmittel-Auswahl (Horizontal Scroll) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,5,0,0">
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="btnModeAuto" Text="🚗 Auto" Command="{Binding TransportModeCommand}" CommandParameter="car" HeightRequest="36" BackgroundColor="#E1F0FF" TextColor="#1B72E8" CornerRadius="18" FontSize="12" FontAttributes="Bold" />
                        <Button x:Name="btnModeBike" Text="🚲 Rad" Command="{Binding TransportModeCommand}" CommandParameter="bike" HeightRequest="36" BackgroundColor="#F0F2F5" TextColor="Black" CornerRadius="18" FontSize="12" />
                        <Button x:Name="btnModeFoot" Text="🚶 Fuß" Command="{Binding TransportModeCommand}" CommandParameter="foot" HeightRequest="36" BackgroundColor="#F0F2F5" TextColor="Black" CornerRadius="18" FontSize="12" />
                        <Button x:Name="btnModeHike" Text="🥾 Wandern" Command="{Binding TransportModeCommand}" CommandParameter="hike" HeightRequest="36" BackgroundColor="#F0F2F5" TextColor="Black" CornerRadius="18" FontSize="12" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- 3. UNTERES DETAIL-POPUP (Bottom Sheet bei Suchtreffer) -->
        <Border x:Name="placeDetailPanel"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Margin="0,0,0,0"
                Padding="0"
                BackgroundColor="White"
                StrokeThickness="0"
                IsVisible="{Binding IsPlaceDetailPanelVisible}"
                HeightRequest="280">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>

            <Grid RowDefinitions="100, *" Padding="0">
                <!-- Bild-Platzhalter / Header -->
                <Grid Grid.Row="0" BackgroundColor="#E9ECEF" Padding="0">
                    <!-- Platzhalter für Bilder -->
                    <BoxView Color="#D0D4DC" HorizontalOptions="Fill" VerticalOptions="Fill" />
                    <Label Text="📷 Bild des Ziels" TextColor="#495057" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <!-- Details & Buttons -->
                <VerticalStackLayout Grid.Row="1" Padding="15,10,15,10" Spacing="8">
                    <!-- Titel & Typ -->
                    <Label Text="{Binding PlaceTitle}" FontSize="18" FontAttributes="Bold" TextColor="Black" LineBreakMode="TailTruncation" />
                    
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="{Binding PlaceSubtitle}" FontSize="12" TextColor="Gray" />
                        <Label Text="•" TextColor="Gray" />
                        <!-- Dauer + Icon -->
                        <Label Text="{Binding PlaceDurationText}" FontSize="12" FontAttributes="Bold" TextColor="#1B72E8" />
                    </HorizontalStackLayout>

                    <!-- Aktionsbuttons -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="🗺️ Directions"
                                Command="{Binding DirectionsCommand}"
                                BackgroundColor="#1B72E8"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="45"
                                CornerRadius="22" />
                        
                        <Button Grid.Column="1"
                                Text="🚀 Start"
                                Command="{Binding StartRouteCommand}"
                                BackgroundColor="White"
                                TextColor="#1B72E8"
                                BorderColor="#1B72E8"
                                BorderWidth="1.5"
                                FontAttributes="Bold"
                                HeightRequest="45"
                                CornerRadius="22" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- 4. UNTERES ROUTEN-INFO-PANEL (Wenn eine Route aktiv berechnet ist) -->
        <Border x:Name="routeInfoPanel"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Margin="0,0,0,0"
                Padding="15"
                BackgroundColor="White"
                StrokeThickness="0"
                IsVisible="{Binding IsRouteInfoPanelVisible}"
                HeightRequest="150">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{Binding RouteDurationText}" FontSize="20" FontAttributes="Bold" TextColor="#E67E22" />
                        <Label Text="Schnellste Route basierend auf gewählter Methode." FontSize="11" TextColor="Gray" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding RouteModeIcon}" FontSize="26" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,5,0,0">
                    <Button Grid.Column="0"
                            Text="🚀 Navigation starten"
                            Command="{Binding StartNavigationCommand}"
                            BackgroundColor="#2ECC71"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="45"
                            CornerRadius="22" />
                    <Button Grid.Column="1"
                            Text="❌ Beenden"
                            Command="{Binding ExitRoutingCommand}"
                            BackgroundColor="#E74C3C"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="45"
                            CornerRadius="22" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 5. OBERES NAVIGATION-PANEL (Google Maps Style) -->
        <Border x:Name="navigationBanner"
                VerticalOptions="Start"
                HorizontalOptions="Fill"
                Margin="15,40,15,10"
                BackgroundColor="#1B72E8"
                StrokeThickness="0"
                IsVisible="{Binding IsNavigationBannerVisible}"
                HeightRequest="100">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="60, *" Padding="12" ColumnSpacing="10" VerticalOptions="Center">
                <!-- Richtungs-Emoji -->
                <Label Grid.Column="0" 
                       Text="{Binding NavInstructionIcon}" 
                       FontSize="36" 
                       TextColor="White" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
                
                <!-- Text-Anweisung -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding NavInstructionText}" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="White" />
                    <Label Text="{Binding NavDistanceText}" 
                           FontSize="13" 
                           TextColor="#D0E3FF" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- 6. UNTERES NAVIGATION-FOOTER-PANEL -->
        <Border x:Name="navigationFooter"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Margin="0,0,0,0"
                Padding="15"
                BackgroundColor="White"
                StrokeThickness="0"
                IsVisible="{Binding IsNavigationFooterVisible}"
                HeightRequest="140">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="15">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding NavTimeLeftText}" FontSize="20" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                    <Label Text="{Binding NavDistanceLeftText}" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
                
                <Button Text="✕ Navigation beenden"
                        Command="{Binding ExitNavigationCommand}"
                        BackgroundColor="#E74C3C"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="44"
                        CornerRadius="22"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </Border>

        <!-- KARTEN-STEUERUNGSBUTTONS (Rechts unten) -->
        <VerticalStackLayout VerticalOptions="End" 
                             HorizontalOptions="End" 
                             Margin="20,20,20,160" 
                             Spacing="10">
            <Button x:Name="btnRecenterNav" Text="📍" Command="{Binding RecenterNavCommand}" HeightRequest="50" WidthRequest="50" CornerRadius="25" BackgroundColor="#1B72E8" TextColor="White" IsVisible="{Binding IsRecenterNavVisible}" />
            <Button Text="🧩" Clicked="OnCompassButtonClicked" HeightRequest="50" WidthRequest="50" CornerRadius="25" BackgroundColor="White" />
            <Button Text="🎯" Command="{Binding GPSButtonClickedCommand}" HeightRequest="50" WidthRequest="50" CornerRadius="25" BackgroundColor="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>